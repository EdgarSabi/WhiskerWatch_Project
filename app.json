{
  "expo": {
    "name": "WhiskerWatch",
    "slug": "whiskerWatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDECE0",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.celestriastudio.whiskerwatch"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDECE0",
          "image": "./assets/splash-lara.png",
          "imageWidth": 320
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "11800d00-a6df-40a8-928b-86a32ef47653"
      }
    }
  }
}
