{
  "expo": {
    "name": "whiskerWatch",
    "slug": "whiskerWatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDECE0",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.anonymous.whiskerWatch"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDECE0",
          "image": "./assets/splash-lara.png",
          "imageWidth": 320
        }
      ]
    ]
  }
}
